<?php

/**
 * PHPStan-only stub. TYPO3 v14 introduced TYPO3\CMS\Core\Upgrades\UpgradeWizardInterface,
 * replacing the removed TYPO3\CMS\Install\Updates\UpgradeWizardInterface from v13. Composer
 * only ever installs one of the two version-specific interfaces at a time. This stub lets
 * PHPStan resolve the symbol regardless of which major version is actually installed locally;
 * it is never loaded at runtime (see phpstan.neon "stubFiles").
 */

namespace TYPO3\CMS\Core\Upgrades;

interface UpgradeWizardInterface
{
    public function getTitle(): string;

    public function getDescription(): string;

    public function executeUpdate(): bool;

    public function updateNecessary(): bool;

    /**
     * @return string[]
     */
    public function getPrerequisites(): array;
}
