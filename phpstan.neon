parameters:
    level: 6
    paths:
        - Classes
        - Tests
    excludePaths:
        analyseAndScan:
            - Tests/Functional/Fixtures/*
    phpVersion: 80200
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    scanFiles:
        - Build/phpstan-stubs/UpgradeWizardInterface.v13.stub
        - Build/phpstan-stubs/UpgradeWizardInterface.v14.stub
